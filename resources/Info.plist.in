<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Shi-tate</string>
  <key>CFBundleExecutable</key>
  <string>Shi-tate</string>
  <key>CFBundleIdentifier</key>
  <string>dev.hokupod.shitate</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Shi-tate</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHITATE_VERSION_CORE@</string>
  <key>CFBundleVersion</key>
  <string>@SHITATE_BUNDLE_VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSMultipleInstancesProhibited</key>
  <true/>
  <key>ShitateCommit</key>
  <string>@SHITATE_GIT_COMMIT@</string>
  <key>ShitateVersion</key>
  <string>@SHITATE_DISPLAY_VERSION@</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSMicrophoneUsageDescription</key>
  <string>Shi-tate uses your selected microphone to process and route audio to BlackHole for communication apps.</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
</dict>
</plist>
